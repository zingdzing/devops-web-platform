# Safe local examples for Phase 1, Phase 2, and Phase 3. For Phase 3 use: install -m 600 .env.example .env
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ops_tasks
DB_USER=ops_app
DB_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
DOCKERHUB_USERNAME=replace-with-your-dockerhub-username
