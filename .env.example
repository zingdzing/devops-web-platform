# Safe examples only. Copy this file to .env and replace values locally.
APP_ENV=development
BACKEND_PORT=5000
FRONTEND_PORT=8080
MYSQL_DATABASE=devops_web
MYSQL_USER=devops
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-local-only
DOCKERHUB_USERNAME=replace-with-your-dockerhub-username
